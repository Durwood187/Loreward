{
  "name": "loreward",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension that blurs possible book-series spoilers based on how far you've read.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "test": "node scripts/build.mjs --gen-only && vitest run",
    "typecheck": "node scripts/build.mjs --gen-only && tsc --noEmit",
    "icons": "python3 scripts/make-icons.py",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
